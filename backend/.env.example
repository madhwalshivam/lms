# Copy this file to ".env" for local development and fill in real values.
# On Render, set these same keys in the service's "Environment" tab (do NOT commit .env).

# Port the server listens on. Render injects its own PORT automatically, so this
# is only used locally.
PORT=5000

# MongoDB connection string.
# Local:  mongodb://localhost:27017/urbancruise
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/urbancruise?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/urbancruise

# Secret used to sign JWT login tokens. Use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_secret
